# App
APP_HOST=0.0.0.0
APP_PORT=8080
APP_TIMEZONE=UTC

# Database
DATABASE_URL=postgres://postgres:123456@localhost:5432/sentence_miner?sslmode=disable

# Gemini (set GEMINI_API_KEY to your key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
